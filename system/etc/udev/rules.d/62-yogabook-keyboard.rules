# Yoga Book Halo Keyboard user access & group permissions
KERNEL=="event*", ATTRS{name}=="Goodix Capacitive TouchScreen", TAG+="uaccess", MODE="0660", GROUP="video"
KERNEL=="event*", ATTRS{name}=="virtual-keyboard", TAG+="uaccess", MODE="0660", GROUP="video"
KERNEL=="event*", ATTRS{name}=="virtual-touchpad", TAG+="uaccess", MODE="0660", GROUP="video"
