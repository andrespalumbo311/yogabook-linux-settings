/* Allow wheel group members and user andres to manage touch-keyboard-handler without password */
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "touch-keyboard-handler.service" &&
        (subject.isInGroup("wheel") || subject.user == "andres")) {
        return polkit.Result.YES;
    }
});
