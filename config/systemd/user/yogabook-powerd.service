[Unit]
Description=Yoga Book Low-Battery Alert & Anti-Brownout Protection Daemon
PartOf=mango-session.target
After=mango-session.target

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/home/andres/.local/bin/yogabook-powerd
Restart=always
RestartSec=3

[Install]
WantedBy=mango-session.target
