{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 44,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 40,
  "notification-body-image-height": 80,
  "notification-body-image-width": 160,
  "control-center-width": 360,
  "control-center-height": 440,
  "fit-to-screen": false,
  "widgets": [
    "title",
    "buttons-grid",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Controllo Rapido",
      "clear-all-button": true,
      "button-text": "Cancella"
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰤨   Wi-Fi",
          "type": "toggle",
          "active": true,
          "command": "rfkill toggle wifi",
          "update-command": "rfkill list wifi | grep -q 'Soft blocked: no' && echo true || echo false"
        },
        {
          "label": "󰂯   Bluetooth",
          "type": "toggle",
          "active": false,
          "command": "rfkill toggle bluetooth",
          "update-command": "rfkill list bluetooth | grep -q 'Soft blocked: no' && echo true || echo false"
        },
        {
          "label": "󰂛   Non disturbare",
          "type": "toggle",
          "active": false,
          "command": "swaync-client -d -sw",
          "update-command": "swaync-client -D 2>/dev/null | grep -q true && echo true || echo false"
        },
        {
          "label": "   Tastiera",
          "command": "/home/andres/.local/bin/toggle-keyboard"
        },
        {
          "label": "   Screenshot",
          "command": "sh -c 'grim -g \"$(slurp)\" - | wl-copy && notify-send \"Screenshot\" \"Area copiata negli appunti\"'"
        },
        {
          "label": "󰕾   Muto Audio",
          "type": "toggle",
          "active": false,
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "update-command": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false"
        },
        {
          "label": "󰤄   Sospendi",
          "command": "systemctl suspend"
        },
        {
          "label": "󰐥   Spegni",
          "command": "systemctl poweroff"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃠",
      "device": "intel_backlight",
      "min": 5
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 16
    }
  }
}
