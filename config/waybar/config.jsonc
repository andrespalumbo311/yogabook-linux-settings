{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 6,
    "modules-left": [
        "custom/launcher",
        "group/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/keyboard",
        "network",
        "battery",
        "tray",
        "custom/notification",
        "custom/close"
    ],
    "custom/launcher": {
        "format": "󰀻",
        "tooltip": "Menu Applicazioni Touch",
        "on-click": "/home/andres/.local/bin/toggle-launcher"
    },
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/ws1",
            "custom/ws2",
            "custom/ws3",
            "custom/ws4",
            "custom/ws5",
            "custom/ws6"
        ]
    },
    "custom/ws1": {
        "exec": "/home/andres/.local/bin/ws-status 1",
        "return-type": "json",
        "interval": "once",
        "signal": 1,
        "on-click": "mmsg dispatch view,1"
    },
    "custom/ws2": {
        "exec": "/home/andres/.local/bin/ws-status 2",
        "return-type": "json",
        "interval": "once",
        "signal": 1,
        "on-click": "mmsg dispatch view,2"
    },
    "custom/ws3": {
        "exec": "/home/andres/.local/bin/ws-status 3",
        "return-type": "json",
        "interval": "once",
        "signal": 1,
        "on-click": "mmsg dispatch view,3"
    },
    "custom/ws4": {
        "exec": "/home/andres/.local/bin/ws-status 4",
        "return-type": "json",
        "interval": "once",
        "signal": 1,
        "on-click": "mmsg dispatch view,4"
    },
    "custom/ws5": {
        "exec": "/home/andres/.local/bin/ws-status 5",
        "return-type": "json",
        "interval": "once",
        "signal": 1,
        "on-click": "mmsg dispatch view,5"
    },
    "custom/ws6": {
        "exec": "/home/andres/.local/bin/ws-status 6",
        "return-type": "json",
        "interval": "once",
        "signal": 1,
        "on-click": "mmsg dispatch view,6"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "/home/andres/.local/bin/toggle-control-center"
    },
    "custom/keyboard": {
        "format": "",
        "tooltip": false,
        "on-click": "/home/andres/.local/bin/toggle-keyboard"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format": "{essid} ({signalStrength}%)",
        "on-click": "/home/andres/.local/bin/toggle-control-center"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\nConsumo: {power:.2f}W\nSalute: {health}%",
        "tooltip-format-charging": "{timeTo}\nCarica: {power:.2f}W\nSalute: {health}%",
        "tooltip-format-plugged": "Alimentatore collegato\nSalute: {health}%",
        "on-click": "/home/andres/.local/bin/toggle-control-center"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8
    },
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "dnd": "󰂛",
            "default": "󰂚"
        },
        "return-type": "json",
        "exec": "/home/andres/.local/bin/yogabook-mako-status",
        "interval": 30,
        "signal": 9,
        "on-click": "/home/andres/.local/bin/toggle-control-center",
        "on-click-right": "makoctl mode -t dnd && pkill -RTMIN+9 waybar",
        "on-click-middle": "makoctl restore",
        "escape": true
    },
    "custom/close": {
        "format": "",
        "tooltip": false,
        "on-click": "/home/andres/.local/bin/close-window"
    }
}
