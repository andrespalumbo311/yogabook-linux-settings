        group_vkeyboard = Adw.PreferencesGroup()
        group_vkeyboard.set_title("Tastiera a Schermo (wvkbd)")
        group_vkeyboard.set_description("Tastiera touch virtuale per l'utilizzo in modalità tablet o tenda")

        row_toggle_vk = Adw.ActionRow()
