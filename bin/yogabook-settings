    def _load_dark_mode_state(self):
        is_dark = False
        try:
            res = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"], capture_output=True, text=True, check=False)
            if "prefer-dark" in res.stdout:
                is_dark = True
            elif "prefer-light" in res.stdout:
                is_dark = False
            elif os.path.exists(GTK4_SETTINGS_PATH):
                with open(GTK4_SETTINGS_PATH, "r") as f:
                    for line in f:
                        if "gtk-application-prefer-dark-theme" in line:
                            val = line.split("=", 1)[1].strip()
                            is_dark = (val == "1")
        except Exception:
            pass
        self.switch_dark.set_active(is_dark)

    def _on_dark_mode_toggled(self, switch, param):
        is_dark = switch.get_active()
        sm = Adw.StyleManager.get_default()
        sm.set_color_scheme(Adw.ColorScheme.FORCE_DARK if is_dark else Adw.ColorScheme.FORCE_LIGHT)

        val_str = "1" if is_dark else "0"
        scheme = "prefer-dark" if is_dark else "prefer-light"
        gtk_theme = "Adwaita-dark" if is_dark else "Adwaita"
        icon_theme = "Papirus-Dark" if is_dark else "Papirus-Light"

        def _worker():
            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme], check=False)
            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", gtk_theme], check=False)
            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", icon_theme], check=False)

            for p in [GTK4_SETTINGS_PATH, GTK3_SETTINGS_PATH]:
                if os.path.exists(p):
                    try:
                        with open(p, "r") as f:
                            lines = f.readlines()
                        out = []
                        found_dark = False
                        found_icon = False
                        for l in lines:
                            if l.startswith("gtk-application-prefer-dark-theme"):
                                out.append(f"gtk-application-prefer-dark-theme={val_str}\n")
                                found_dark = True
                            elif l.startswith("gtk-icon-theme-name"):
                                out.append(f"gtk-icon-theme-name={icon_theme}\n")
                                found_icon = True
                            else:
                                out.append(l)
                        if not found_dark:
                            out.append(f"gtk-application-prefer-dark-theme={val_str}\n")
                        if not found_icon:
                            out.append(f"gtk-icon-theme-name={icon_theme}\n")
                        with open(p, "w") as f:
                            f.writelines(out)
                    except Exception as e:
                        print(f"Error updating {p}: {e}")

        threading.Thread(target=_worker, daemon=True).start()


def main():
    app = YogaBookSettingsApp()
    sys.exit(app.run([]))


if __name__ == "__main__":
    main()
