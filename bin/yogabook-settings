        row_toggle_vk.add_suffix(btn_vk)
        group_vkeyboard.add(row_toggle_vk)

        page.add(group_vkeyboard)

        # --- Group C: Wacom Create Pad ---
        group_wacom = Adw.PreferencesGroup()
        group_wacom.set_title("Tavoletta Grafica e Penna Wacom EMR")
        group_wacom.set_description("Superficie Create Pad integrata con digitizzatore a risonanza elettromagnetica")

        row_wacom = Adw.ActionRow()
        row_wacom.set_title("Digitizzatore Penna")
        row_wacom.set_subtitle("Wacom HID 169 (WCOM0019:00) | 2048 livelli di pressione")
        lbl_wacom_map = Gtk.Label(label="Mappato a DSI-1")
        lbl_wacom_map.add_css_class("dim-label")
        row_wacom.add_suffix(lbl_wacom_map)
        group_wacom.add(row_wacom)

        page.add(group_wacom)
        self.add(page)

        self._load_halo_backlight()

    def _load_halo_backlight(self):
        def _worker():
            try:
                res = subprocess.run(["brightnessctl", "--device=ybwmi::kbd_backlight", "get"], capture_output=True, text=True, check=False)
                raw = int(res.stdout.strip())
                pct = int(round(raw * 100 / 255.0))
                def _ui():
                    self.syncing_halo = True
                    self.scale_halo.set_value(pct)
                    self.lbl_halo_val.set_text(f"{pct}%")
                    self.syncing_halo = False
                GLib.idle_add(_ui)
            except Exception:
                pass
        threading.Thread(target=_worker, daemon=True).start()

    def _on_halo_backlight_changed(self, scale):
        pct = int(scale.get_value())
        self.lbl_halo_val.set_text(f"{pct}%")
        if not self.syncing_halo:
            self.pending_halo = pct
            if self.halo_debounce_timer is None:
                self.halo_debounce_timer = GLib.timeout_add(30, self._apply_pending_halo)

    def _apply_pending_halo(self):
        if self.pending_halo is not None:
            p = self.pending_halo
            self.pending_halo = None
            threading.Thread(
                target=lambda: subprocess.run(
                    ["brightnessctl", "--device=ybwmi::kbd_backlight", "set", f"{p}%"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False
                ),
                daemon=True
            ).start()
        self.halo_debounce_timer = None
        return GLib.SOURCE_REMOVE

