    def _refresh_battery_metrics(self):
        def _worker():
            try:
                uevent_path = "/sys/class/power_supply/bq27542-0/uevent"
                if not os.path.exists(uevent_path):
                    return
                with open(uevent_path, "r") as f:
                    content = f.read()
                props = dict(line.split("=", 1) for line in content.splitlines() if "=" in line)

                status = props.get("POWER_SUPPLY_STATUS", "Discharging")
                charge_now = int(props.get("POWER_SUPPLY_CHARGE_NOW", 0))
                charge_full = int(props.get("POWER_SUPPLY_CHARGE_FULL", 1))
                charge_design = int(props.get("POWER_SUPPLY_CHARGE_FULL_DESIGN", 1))
                voltage_now = int(props.get("POWER_SUPPLY_VOLTAGE_NOW", 0))
                current_now = int(props.get("POWER_SUPPLY_CURRENT_NOW", 0))
                temp_raw = int(props.get("POWER_SUPPLY_TEMP", 0))
                cycles = props.get("POWER_SUPPLY_CYCLE_COUNT", "--")
                time_to_empty = int(props.get("POWER_SUPPLY_TIME_TO_EMPTY_NOW", 0))

                pct = min(100, max(0, int(round(charge_now * 100.0 / charge_full)))) if charge_full > 0 else 0
                power_w = abs(voltage_now * current_now) / 1e12

                status_ita = "In carica" if status == "Charging" else ("Carica completa" if status == "Full" else "In uso a batteria")

                time_str = ""
                if status == "Discharging" and time_to_empty > 0:
                    hrs = time_to_empty // 3600
                    mins = (time_to_empty % 3600) // 60
                    time_str = f"  •  Autonomia stimata: {hrs}h {mins:02d}m"

                health_pct = int(round(charge_full * 100.0 / charge_design)) if charge_design > 0 else 100

                def _ui():
                    self.lbl_batt_pct.set_text(f"{pct}%")
                    self.row_batt_charge.set_subtitle(f"Stato: {status_ita}{time_str}")

                    self.lbl_batt_power.set_text(f"{power_w:.2f} W")
                    prefix_pwr = "Erogazione" if status == "Charging" else "Consumo"
                    self.row_batt_power.set_subtitle(f"{prefix_pwr}: {voltage_now/1e6:.2f} V  •  {abs(current_now)/1e6:.2f} A")

                    self.lbl_batt_temp.set_text(f"{temp_raw/10.0:.1f} °C")

                    self.lbl_health_pct.set_text(f"{health_pct}%")
                    self.row_health.set_subtitle(f"Capacità attuale: {charge_full//1000} mAh  •  Capacità di fabbrica: {charge_design//1000} mAh")

                    self.lbl_cycles.set_text(f"{cycles} cicli")
                    self.row_cycles.set_subtitle("Cicli totali registrati dal fuel gauge hardware")

                GLib.idle_add(_ui)
            except Exception as e:
                print(f"Error reading battery metrics: {e}")

        threading.Thread(target=_worker, daemon=True).start()

