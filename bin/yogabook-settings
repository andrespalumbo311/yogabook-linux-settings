        btn_mute_source.set_tooltip_text("Attiva / Disattiva Muto Microfono")
        btn_mute_source.connect("clicked", lambda b: self._toggle_source_mute())

        box_mic.append(self.scale_mic)
        box_mic.append(self.lbl_mic_val)
