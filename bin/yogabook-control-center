#!/usr/bin/env python3
"""
Native Material Design 3 Hardware-Accelerated Touch Control Center for Lenovo Yoga Book.
Built with GTK 4 & Gtk4LayerShell for MangoWC / wlroots.
Features:
- Attached flush to the bottom of Waybar (margin-top: 40px, 0 gap)
- Real working volume slider via WirePlumber / PipeWire (wpctl) with debounced non-blocking async updates
- Real working backlight slider via intel_backlight (brightnessctl)
- Large touch-friendly Material You 3 quick toggle pills (Wi-Fi, Bluetooth, Touch Keyboard, Auto-Rotate, Silent, Screenshot)
- Real-time battery status and session actions (Suspend, Reboot, Shutdown)
- Dismiss on tap/click outside card or Escape key
- Instant toggle (<10ms via SIGUSR1 daemon)
- 0.0% CPU when idle / hidden
"""

import sys
import os
import atexit
import signal
import subprocess
import re
import threading
import time

# Ensure libgtk4-layer-shell is preloaded before libwayland-client
if "libgtk4-layer-shell.so" not in os.environ.get("LD_PRELOAD", ""):
    env = dict(os.environ)
    preload = env.get("LD_PRELOAD", "")
    env["LD_PRELOAD"] = f"/usr/lib/libgtk4-layer-shell.so:{preload}".strip(":")
    os.execve(sys.executable, [sys.executable] + sys.argv, env)

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')
gi.require_version('Gtk4LayerShell', '1.0')
from gi.repository import Gtk, Gdk, Gtk4LayerShell, GLib, Pango

PIDFILE = "/tmp/yogabook-control-center.pid"


def cleanup():
    try:
        if os.path.exists(PIDFILE):
            os.remove(PIDFILE)
    except OSError:
        pass


atexit.register(cleanup)

