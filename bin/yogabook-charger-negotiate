#!/usr/bin/env bash
# ==============================================================================
# yogabook-charger-negotiate
# Holds a sleep/lid inhibitor lock to allow bq25890_pump_express_work in the
# kernel to complete MediaTek Pump Express+ high-voltage (12V) negotiation.
# ==============================================================================

set -euo pipefail

PWRSRC_ONLINE_SYSFS="/sys/class/power_supply/cht_wcove_pwrsrc/online"
BATTERY_CURRENT_SYSFS="/sys/class/power_supply/bq27542-0/current_now"

# If AC is not connected, exit immediately
ONLINE="$(cat "$PWRSRC_ONLINE_SYSFS" 2>/dev/null || echo 0)"
if [ "$ONLINE" != "1" ]; then
    exit 0
fi

logger -t yogabook-charger "Charger connection detected. Acquiring sleep lock for Pump Express negotiation (25s max)..."

# Acquire high-level inhibitor on sleep and lid switch actions so systemd-logind
# does NOT re-suspend the machine while the kernel workqueue pulses Pump Express.
exec systemd-inhibit \
    --what="handle-lid-switch:sleep" \
    --who="yogabook-charger" \
    --why="Allow Pump Express high-voltage negotiation to complete" \
    --mode=block \
    bash -c '
        # Pump Express starts after a 5-second kernel delay (PUMP_EXPRESS_START_DELAY)
        # and steps up voltage over ~10-15 seconds. Hold lock for at least 18s and up to 25s.
        for i in $(seq 1 25); do
            sleep 1

            ONLINE="$(cat /sys/class/power_supply/cht_wcove_pwrsrc/online 2>/dev/null || echo 0)"
            if [ "$ONLINE" != "1" ]; then
                logger -t yogabook-charger "Charger disconnected during negotiation. Releasing lock."
                exit 0
            fi

            # After 18 seconds, check if high-current charging (>1.8A into battery) is established
            if [ "$i" -ge 18 ]; then
                BATT_CURR="$(cat /sys/class/power_supply/bq27542-0/current_now 2>/dev/null || echo 0)"
                if [ "$BATT_CURR" -ge 1800000 ]; then
                    logger -t yogabook-charger "Pump Express 12V fast charging verified (${BATT_CURR} uA into battery at ${i}s). Releasing sleep lock."
                    exit 0
                fi
            fi
        done

        logger -t yogabook-charger "Pump Express negotiation hold complete (25s). Releasing sleep lock."
    '
